# ============================================================================
#  GHURAGHURI - SERVER-SIDE ENVIRONMENT (SAFE TEMPLATE TO COMMIT)
#  Copy this file to api/.env and fill in your real keys.
#  api/.env is ignored by .gitignore and must NEVER be committed.
# ============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development            # development | production
APP_DEBUG=true                 # show technical errors only in development
APP_BASE_URL=http://localhost/ghuraghuri/

# ---------------------------------------------------------------------------
# Admin API token (protects admin write endpoints).
# Generate one, e.g.  php -r "echo bin2hex(random_bytes(16));"
# ---------------------------------------------------------------------------
ADMIN_API_TOKEN=change_me_to_a_long_random_string

# ---------------------------------------------------------------------------
# Database (optional - the API works without MySQL, uses file cache + demo)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ghuraghuri
DB_USER=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Google Places API (New) - https://developers.google.com/maps/documentation/places
# Used by the GooglePlacesProvider for hotels, restaurants and autocomplete.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
# Optional Places fields to reduce payloads / quota (defaults are sensible).
GOOGLE_PLACES_FIELDS=places.displayName,places.formattedAddress,places.location,places.rating,places.userRatingCount,places.googleMapsUri,places.websiteUri,places.nationalPhoneNumber,places.primaryType,places.types,places.photos,places.priceLevel,places.internationalPhoneNumber

# ---------------------------------------------------------------------------
# Booking.com Demand API (optional - NOT CONFIGURED until credentials exist)
# ---------------------------------------------------------------------------
BOOKING_API_KEY=
BOOKING_AFFILIATE_ID=

# ---------------------------------------------------------------------------
# Expedia / Rapid API (optional - NOT CONFIGURED until credentials exist)
# ---------------------------------------------------------------------------
EXPEDIA_API_KEY=

# ---------------------------------------------------------------------------
# Transport provider (optional - e.g. a bus/train/flight aggregator API)
# ---------------------------------------------------------------------------
TRANSPORT_API_KEY=
TRANSPORT_API_URL=

# ---------------------------------------------------------------------------
# Routing provider (optional - Google Routes API). If empty, the API returns
# an estimated route (Haversine + road factor) clearly labelled as estimate.
# ---------------------------------------------------------------------------
ROUTES_API_KEY=

# ---------------------------------------------------------------------------
# Caching / rate limiting (server-side)
# ---------------------------------------------------------------------------
CACHE_DIR=../cache                # path relative to api/
CACHE_TTL_SECONDS=300             # static POI cache lifetime
RATE_LIMIT_PER_MINUTE=120         # requests per IP per minute
RATE_LIMIT_ENABLED=true